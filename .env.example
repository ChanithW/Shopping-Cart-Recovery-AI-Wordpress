# Environment configuration for Shopping Cart Recovery AI System

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# API Security
API_TOKEN=d405b55571c2b2471760c4ccfc6a62a9d8e8ee5e15a3cccd6a576cf69939f379

# Database Configuration (MySQL/MariaDB)
DATABASE_URL=mysql+pymysql://username:password@localhost/database_name

# Email Configuration (Optional - for direct sending)
SEND_EMAIL_DIRECTLY=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
