# Service Ports
ABANDONMENT_DETECTOR_PORT=8005
EMAIL_GENERATOR_PORT=8002

# WordPress Integration
WP_SITE_URL=http://localhost/wordpress
WP_DB_HOST=localhost
WP_DB_NAME=wordpress_db
WP_DB_USER=wp_user
WP_DB_PASS=wp_password